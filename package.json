{
  "name": "stive_automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "node scripts/run-parallel.js",
    "test:parallel": "node scripts/run-parallel.js",
    "report:merge": "node scripts/merge-reports.js",
    "test:chunk1": "cross-env CHUNK=0 codeceptjs run --config codecept.conf.js",
    "test:chunk2": "cross-env CHUNK=1 codeceptjs run --config codecept.conf.js",
    "test:chunk3": "cross-env CHUNK=2 codeceptjs run --config codecept.conf.js",
    "test:chunk4": "cross-env CHUNK=3 codeceptjs run --config codecept.conf.js",
    "test:chunk5": "cross-env CHUNK=4 codeceptjs run --config codecept.conf.js",
    "test:single": "cross-env CHUNK=0 CHUNK_COUNT=1 codeceptjs run --config codecept.conf.js",
    "test:smoke": "cross-env CHUNK=0 CHUNK_COUNT=1 ROW_LIMIT=5 codeceptjs run --config codecept.conf.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "codeceptjs": "^3.7.3",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.1.0",
    "googleapis": "^148.0.0",
    "js-base64": "^3.7.7",
    "mochawesome": "7.1.3",
    "webdriverio": "^9.12.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
